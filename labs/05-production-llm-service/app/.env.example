# Variable names only. Never put real values here; never commit .env or .env.local.
# Server-side only: none of these may use a NEXT_PUBLIC_ prefix.
#
# Phase 1 reads NO environment variables. The names below are reserved for the
# phases that introduce them and are not read by the code yet.

# Phase 3 — OpenAI (server side only). Not read until Phase 3.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Phase 5 — pricing metadata for ESTIMATED cost. Not read until Phase 5.
# MODEL_INPUT_USD_PER_1M=
# MODEL_CACHED_INPUT_USD_PER_1M=
# MODEL_OUTPUT_USD_PER_1M=
# MODEL_PRICING_AS_OF=

# Kill switch. Not read until the phase that implements it (Phase 6+).
# SERVICE_ENABLED=
