# Generated by ai-golden-path from template {{ template_id }}@{{ template_version }}
# (Change Explainer reference template).
#
# This file is owned by the product team. REVIEW BEFORE USE:
#   - spec.purpose is a STARTER DEFAULT copied from the reference template.
#     Replace it with what this capability actually does.
#   - spec.data.sensitivity is a STARTER DEFAULT ("synthetic") because the
#     reference template only uses synthetic data. It is NOT a safe default
#     for real capabilities: classify the data before using anything real.
#
# Platform-managed keys (do not edit by hand; a future upgrade tool owns them):
#   api_version, kind, metadata.template_version
# This file is validated at runtime against platform/capability.schema.json.
#
# Never put secrets, credentials, endpoints or provider model IDs in this file.
api_version: ai.platform/v1
kind: Capability

metadata:
  name: "{{ name }}"
  version: "0.1.0"           # capability version (product-team-owned)
  template_version: "{{ template_version }}"  # template provenance (platform-managed)

spec:
  # STARTER DEFAULT: review and replace.
  purpose: >-
    Starter capability from the golden-path Change Explainer template: explains
    a synthetic software change in structured language. Replace with this
    capability's actual purpose.

  # STARTER DEFAULT: synthetic change-metadata schemas; replace with your domain.
  inputs:
    schema: schemas/input.schema.json
  outputs:
    schema: schemas/output.schema.json

  model:
    profile: balanced
    # Resolved through the explicit ADAPTERS registry in src/capability.py.
    # Template {{ template_version }} ships only the deterministic "fake" adapter.
    adapter: fake

  authority:
    # Least privilege: no tools are declared, so the model is shown none and
    # every tool proposal is rejected. Declaring a tool is an ALLOWLIST, not a
    # grant: the runtime still validates every proposal, and the policy hook
    # decides. Only tools in the trusted TOOL_REGISTRY (src/tools.py) may be
    # declared. Examples (synthetic tools):
    #   tools: [lookup_change_context]   # low impact: allowed by DefaultPolicy
    #   tools: [publish_change_notice]   # high impact: DENIED by DefaultPolicy
    #                                    # unless trusted code injects a policy
    tools: []

  budgets:
    max_model_requests: 2    # ENFORCED at runtime (src/capability.py)
    max_output_tokens: 800   # declared intent only; passed to the adapter, not measured
    max_latency_ms: 5000     # MEASURED in telemetry (latency.over_declared_max); NOT enforced

  data:
    # STARTER DEFAULT: the reference template uses synthetic data only.
    # Review this classification before using any real data.
    sensitivity: synthetic

  evaluation:
    # ENFORCED by evals/evaluator.py: its exit code is the eval gate
    # (0 = observed pass rate meets required_pass_rate, 1 = it does not).
    suite: evals/cases.yaml
    required_pass_rate: 1.0

  observability:
    # Emitted by src/telemetry.py as OpenTelemetry-STYLE span records (JSONL on
    # stderr by default). Usage is adapter-reported (unknown stays null, never 0).
    # Cost is estimated only with an explicit matching price in pricing.yaml.
    tracing: true
    usage: true
    cost: true
