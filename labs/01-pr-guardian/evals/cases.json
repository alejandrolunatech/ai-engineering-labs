{
  "schema_version": 1,
  "description": "Behavioral expectations for the PR Guardian learning eval suite. These expectations define observable behavior without requiring exact model wording.",
  "cases": [
    {
      "case_id": "01-duplicate-charge",
      "expected_finding": true,
      "zero_findings_is_correct": false,
      "expected_files": [
        "src/billing/payments.py"
      ],
      "minimum_severity": "high",
      "required_concept_groups": [
        [
          "idempotency",
          "idempotency key"
        ],
        [
          "retry",
          "attempt"
        ],
        [
          "duplicate charge",
          "double charge",
          "multiple charges",
          "charged twice",
          "deduplicate"
        ]
      ],
      "forbidden_finding_terms": [
        "logging style",
        "backoff style",
        "naming preference"
      ],
      "rationale": "Retries use a different idempotency key per attempt. A gateway timeout may occur after the charge was applied, so using a new key on retry can cause the order to be charged more than once."
    },
